# OpenSourceLens Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# Django Security and Core Settings
SECRET_KEY=django-insecure-opensourcelens-change-in-production-example-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Primary Production Configuration: PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=opensourcelens
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Set to True only for offline local development without PostgreSQL
USE_SQLITE=False

# GitHub API Configuration
# Optional personal access token (classic or fine-grained) to increase rate limit from 60 to 5,000 requests/hour.
# Keep this token secret. Never commit this token to version control.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=12

# Analytics Cache Freshness (in minutes)
ANALYSIS_CACHE_FRESHNESS_MINUTES=60
