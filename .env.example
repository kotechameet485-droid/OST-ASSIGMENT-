# ==============================================================================
# OpenSourceLens Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development.
# In production (e.g. Vercel Project Settings), configure these variables directly.
# NEVER commit your actual .env file or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY IN PRODUCTION
# ------------------------------------------------------------------------------

# Must be a long, cryptographically secure random string (at least 50 characters).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Startup fails safely in production if missing, default, or insecure.
SECRET_KEY=replace-with-your-strong-random-django-secret-key-at-least-50-chars

# Set to False in production. Defaults to False if omitted.
DEBUG=False

# Comma-separated list of allowed host/domain names.
# .vercel.app is automatically included for Vercel preview/production domains.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Production Database (Unified connection URL recommended for Neon, Supabase, AWS RDS, etc.)
# Automatically parses URL-encoded credentials and parameters like ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-db.us-east-2.aws.neon.tech/opensourcelens?sslmode=require

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE DATABASE CONFIGURATION (Individual DB_* variables)
# ------------------------------------------------------------------------------
# Used only if DATABASE_URL is not provided:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=opensourcelens
# DB_USER=postgres
# DB_PASSWORD=your_secure_postgres_password
# DB_HOST=ep-example-db.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 3. OPTIONAL SETTINGS & PERFORMANCE TUNING
# ------------------------------------------------------------------------------

# GitHub Personal Access Token (classic: public_repo read-only, or fine-grained read-only).
# Optional: Increases GitHub API rate limit from 60 to 5,000 requests/hour.
# If omitted, OpenSourceLens uses unauthenticated access for public repositories.
GITHUB_TOKEN=your_github_token_here

# GitHub API configuration
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=12

# CSRF Trusted Origins (Comma-separated HTTPS origins).
# https://*.vercel.app is automatically included by default.
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Cache freshness threshold in minutes before re-querying the GitHub API
ANALYSIS_CACHE_FRESHNESS_MINUTES=60

# HTTPS Security Hardening (Enabled by default when DEBUG=False)
# Automatically sets SECURE_SSL_REDIRECT=True, secure session/CSRF cookies, and HSTS.
ENABLE_HTTPS_SECURITY=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 4. LOCAL DEVELOPMENT OVERRIDES
# ------------------------------------------------------------------------------
# Set to True locally to bypass PostgreSQL and use isolated SQLite.
USE_SQLITE=True
