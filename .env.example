# OpenSourceLens Environment Configuration Template
# Copy this file to .env and configure values for your environment.

SECRET_KEY=replace-with-your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=opensourcelens
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

USE_SQLITE=False

# Optional GitHub Personal Access Token to expand rate limit from 60 to 5,000 req/hr
# Leave empty for unauthenticated requests. Never commit actual tokens.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=12

ANALYSIS_CACHE_FRESHNESS_MINUTES=60
ENABLE_HTTPS_SECURITY=False
