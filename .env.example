# OpenSourceLens Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit your actual .env file or production credentials to version control.

# Django Core Security
# In production, set DEBUG=False and provide a strong random SECRET_KEY
SECRET_KEY=replace-with-your-strong-random-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration (PostgreSQL in Production)
# Option A: Standard PostgreSQL individual connection parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=opensourcelens
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Option B: Unified Database URL (Supported by Heroku, Render, Railway, Neon, etc.)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/opensourcelens

# Local development override (Set to True to use local SQLite)
USE_SQLITE=False

# GitHub REST API Integration
# Optional Personal Access Token (classic: public_repo read-only, or fine-grained read-only)
# Expands rate limit quota from 60 req/hr to 5,000 req/hr.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=12

# Cache & Telemetry Freshness
ANALYSIS_CACHE_FRESHNESS_MINUTES=60

# Production Security & HTTPS Hardening
# Set to True in production to enforce HTTPS redirects, HSTS, and secure cookies
ENABLE_HTTPS_SECURITY=False
SECURE_HSTS_SECONDS=31536000
